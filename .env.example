# ---------------------------------------------------------------------------
# asms2 环境变量模板
# 复制为 .env.local（本地开发）或配置到部署平台：
#   cp .env.example .env.local
# 注意：所有 replace-with-* 都只是占位值，必须替换后再启动/部署
# ---------------------------------------------------------------------------

# 数据库连接
# 本地 SQLite：file:./data/asms2.db
# Turso 远程：libsql://<db>-<org>.turso.io
DATABASE_URL="file:./data/asms2.db"

# 仅 Turso 远程需要
DATABASE_AUTH_TOKEN=

# Better Auth
# 对外访问地址，必须与浏览器地址一致（影响 OAuth 回调与 Cookie）
BETTER_AUTH_URL=http://localhost:3000
# 至少 32 字节随机串：openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# 服务商 Key / OAuth Secret / Webhook 签名密钥的加密密钥
# 必须是 32 字节的 base64：openssl rand -base64 32
# 丢失后所有已保存的密钥都需要重新录入
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64

# 定时任务鉴权：Authorization: Bearer <CRON_SECRET>
# 生成：openssl rand -hex 16
CRON_SECRET=replace-with-random-hex

# 首个管理员邮箱：站内还没有管理员时，该账号注册后自动提权
# 可选；不填则需要手动在数据库里设置 role='admin'
BOOTSTRAP_ADMIN_EMAIL=

# 页面 CSP 模式：enforce（默认）/ report-only / off；开发态（bun run dev）始终关闭
# 上线后如果发现页面功能异常，可先改成 report-only 并在浏览器控制台查看被拦截的资源
CSP_MODE=

# 人机校验（工作量证明）的难度上限，默认 100000，浏览器平均约 0.3–1.5 秒
POW_MAX_NUMBER=
